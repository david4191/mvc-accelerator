{
  "name": "php-mvc-accelerator",
  "publisher": "local-dev",
  "displayName": "PHP MVC Accelerator",
  "description": "Generate and continue building PHP MVC projects from VS Code using your MVC Accelerator account",
  "version": "2.0.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onCommand:mvcAccelerator.login",
    "onCommand:mvcAccelerator.logout",
    "onView:mvcAcceleratorProjects"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mvcAccelerator.login",
        "title": "MVC Accelerator: Login"
      },
      {
        "command": "mvcAccelerator.logout",
        "title": "MVC Accelerator: Logout"
      },
      {
        "command": "mvcAccelerator.refreshProjects",
        "title": "MVC Accelerator: Refresh Projects",
        "icon": "$(refresh)"
      },
      {
        "command": "mvcAccelerator.continueProject",
        "title": "MVC Accelerator: Continue Building This Project"
      },
      {
        "command": "mvcAccelerator.newProjectPrompt",
        "title": "MVC Accelerator: New Project / Prompt"
      },
      {
        "command": "mvcAccelerator.planBuild",
        "title": "MVC Accelerator: Plan a Bulk Build"
      },
      {
        "command": "mvcAccelerator.syncToWorkspace",
        "title": "MVC Accelerator: Sync Project Files to Local Folder"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "mvcAcceleratorProjects",
          "name": "MVC Accelerator Projects"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "mvcAccelerator.refreshProjects",
          "when": "view == mvcAcceleratorProjects",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "mvcAccelerator.continueProject",
          "when": "view == mvcAcceleratorProjects && viewItem == project"
        },
        {
          "command": "mvcAccelerator.syncToWorkspace",
          "when": "view == mvcAcceleratorProjects && viewItem == project"
        }
      ]
    },
    "configuration": {
      "title": "MVC Accelerator",
      "properties": {
        "mvcAccelerator.apiUrl": {
          "type": "string",
          "default": "https://mvc-accelerator.onrender.com/api",
          "description": "Base URL of the MVC Accelerator API. Point this at http://localhost:8000 for local development."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "@types/fs-extra": "^11.0.4",
    "@vscode/vsce": "^2.32.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "axios": "^1.3.0",
    "fs-extra": "^11.1.0"
  },
  "overrides": {
    "markdown-it": "14.3.1"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true,
    "keytar": false
  }
}
